# Server Configuration
PORT=3000
NODE_ENV=development
HOST=0.0.0.0

# FlatTrade API Configuration
FLATTRADE_HOST=https://piconnect.flattrade.in/PiConnectTP
FLATTRADE_WEBSOCKET=wss://piconnect.flattrade.in/PiConnectWSTp/

# Security Configuration
SESSION_SECRET=your-session-secret-key-here
JWT_SECRET=your-jwt-secret-key-here
ENCRYPTION_KEY=your-encryption-key-here

# CORS Configuration
CORS_ORIGIN=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# WebSocket Configuration
WS_MAX_CONNECTIONS=100
WS_HEARTBEAT_INTERVAL=30000
WS_CONNECTION_TIMEOUT=60000

# Cache Configuration
OPTION_CHAIN_TTL=30000
MARKET_DATA_TTL=1000
SESSION_TTL=3600000

# Logging Configuration
LOG_LEVEL=info
LOG_FILE=app.log
LOG_MAX_SIZE=10m
LOG_MAX_FILES=5

# Database Configuration (if needed in future)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=trading_app
# DB_USER=your_db_user
# DB_PASSWORD=your_db_password

# Trading Configuration
DEFAULT_EXPIRY_DAYS=7
MAX_ORDER_QUANTITY=1000
ORDER_TIMEOUT=30000

# Market Data Configuration
MARKET_DATA_REFRESH_INTERVAL=1000
POSITION_REFRESH_INTERVAL=5000
ORDER_REFRESH_INTERVAL=2000